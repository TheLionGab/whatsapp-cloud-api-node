{
  "name": "whatsapp-cloud-api-node",
  "version": "0.1.0",
  "description": "MVP WhatsApp Business Cloud API (Meta) — envio de texto + webhook",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:local": "bash scripts/test-local.sh",
    "lint": "node --check dist/index.js 2>/dev/null || echo 'lint: sem eslint configurado, typecheck é o gate'"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.4.0",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
